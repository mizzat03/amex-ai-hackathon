# Safe local-development defaults. Copy to .env and change only as needed.
AMEX_ENVIRONMENT=development
AMEX_API_HOST=127.0.0.1
AMEX_API_PORT=8000
AMEX_SIMULATOR_HOST=127.0.0.1
AMEX_SIMULATOR_PORT=8010
AMEX_SIMULATOR_URL=http://127.0.0.1:8010
AMEX_INGESTION_HOST=127.0.0.1
AMEX_INGESTION_PORT=8020
AMEX_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3100","http://127.0.0.1:3100"]
AMEX_REDIS_URL=redis://localhost:6379/0
AMEX_INGESTION_CLAIM_IDLE_MS=5000
AMEX_POSTGRES_DSN=postgresql://amex:amex@localhost:5432/amex_incidents
AMEX_DEMO_SEED=20260827
AMEX_FRONTEND_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_AMEX_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_AMEX_DATA_MODE=live
AMEX_COPILOT_PROVIDER=disabled
AMEX_COPILOT_MODEL=
AMEX_COPILOT_TIMEOUT_SECONDS=15
AMEX_COPILOT_INITIAL_MAX_OUTPUT_TOKENS=1800
AMEX_COPILOT_FOLLOW_UP_MAX_OUTPUT_TOKENS=1100

# Model credentials remain optional. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AMEX_EVAL_CLAUDE_MODEL=
AMEX_EVAL_TERRA_MODEL=
